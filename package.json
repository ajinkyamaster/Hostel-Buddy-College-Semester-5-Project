{
  "name": "hostel-buddy",
  "version": "1.0.0",
  "description": "Smart Hostel Complaint Management System - Group 19 (Semester 5 Project)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/db/seed.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/run.js",
    "test:auth": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/auth.test.js",
    "test:complaints": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/complaints.test.js",
    "test:admin": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/admin.test.js",
    "test:dashboard": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/dashboard.test.js",
    "test:regression": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/regression.test.js",
    "test:hostels": "node --experimental-sqlite --disable-warning=ExperimentalWarning tests/hostels.test.js",
    "test:deployment": "node --disable-warning=ExperimentalWarning tests/deployment.test.js"
  },
  "keywords": [
    "hostel",
    "complaint-management",
    "express",
    "sqlite"
  ],
  "author": "Group 19",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  }
}
